  "legal_hierarchy": "workflow_guidance",
  "summary": "Public-law scaffold for field review and systematic inspection, linking statutory six-year review, Title 350 recordkeeping, property record accuracy, and future county-specific field forms.",
  "plain_language": "This is the source-grounded shape of field review before your county-specific inspection packet is added.",
  "semantic_tags": [
    "field_review",
    "systematic_inspection",
    "property_record",
    "cama",
    "quality_condition",
    "internal_placeholder"
  ],
  "steps": [
    {
      "order": 1,
      "step": "Identify the class/subclass, review area, or inspection route selected for systematic review."
    },
    {
      "order": 2,
      "step": "Compare current property record data to observable facts, sales review notes, permits, GIS/deed changes, and prior record-card data."
    },
    {
      "order": 3,
      "step": "Record data changes needed for land, improvements, quality, condition, use, occupancy, physical characteristics, and relevant valuation influences."
    },
    {
      "order": 4,
      "step": "Document reasons for deviations from standard manuals, schedules, or tables where applicable."
    },
    {
      "order": 5,
      "step": "Update CAMA/property record fields and preserve the workpaper or audit trail supporting the change."
    },
    {
      "order": 6,
      "step": "Route taxpayer communication, access/refusal handling, photo policy, safety procedure, and county form packets through future internal workflow inserts."
    }
  ],
