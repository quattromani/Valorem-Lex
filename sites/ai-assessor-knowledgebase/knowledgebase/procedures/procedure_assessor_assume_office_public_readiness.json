  ],
  "category": "office_transition",
  "jurisdiction": "Nebraska",
  "legal_hierarchy": "workflow_guidance",
  "summary": "Source-grounded transition checklist for a newly certified Nebraska assessor, excluding internal county procedures and private paperwork until those materials are provided.",
  "plain_language": "A first pass at what must be legally and operationally ready before the office starts moving under your name.",
  "semantic_tags": [
    "assessor_transition",
    "oath",
    "bond",
    "certification",
    "calendar",
    "records",
    "internal_placeholder"
  ],
  "steps": [
    {
      "order": 1,
      "step": "Confirm county assessor certificate status and recertification horizon."
    },
    {
      "order": 2,
      "step": "Complete oath and bond prerequisites before entering duties."
    },
    {
      "order": 3,
      "step": "Map statutory duty inventory: assessment roll, record review, real property revision, omitted property, preliminary meetings if applicable, and obedience to Tax Commissioner/TERC rules and orders."
    },
    {
      "order": 4,
      "step": "Load the PAD calendar, county reports calendar, county clerk/BOE calendar, treasurer calendar, homestead calendar, and education calendar into a working command calendar."
    },
    {
      "order": 5,
      "step": "Inventory open statutory deadlines, open appeals, pending BOE/TERC matters, pending valuation notices, pending exemptions, and reports due to PAD."
    },
    {
      "order": 6,
      "step": "Apply Schedule 14 records-retention triage before disposing, archiving, or reorganizing inherited records."
    },
    {
      "order": 7,
      "step": "Reserve internal extension points for CAMA access, parcel/deed workflow, sales validation, field-review packets, BOE packets, TERC exhibits, staff roles, and public-records intake."
    }
  ],
