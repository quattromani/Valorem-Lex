{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexvalorum.local/schemas/source.schema.json",
  "title": "LexValorum Source",
  "type": "object",
  "required": [
    "id",
    "title",
    "source_type",
    "issuing_authority",
    "jurisdiction",
    "legal_hierarchy",
    "url",
    "accessed_date",
    "status",
    "topics"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "title": { "type": "string" },
    "source_type": { "type": "string" },
    "issuing_authority": { "type": "string" },
    "jurisdiction": { "type": "string" },
    "legal_hierarchy": { "type": "string" },
    "url": { "type": "string" },
    "publication_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "publication_date_note": { "type": ["string", "null"] },
    "accessed_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "type": "string" },
    "topics": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": ["string", "null"] }
  }
}
